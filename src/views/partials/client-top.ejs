<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= typeof title !== 'undefined' ? title : 'My Case' %> — <%= brand.name %></title>
  <link rel="stylesheet" href="/assets/app.css">
</head>
<body class="bg-cream font-sans text-navy-900 antialiased">
<header class="border-b border-navy-100 bg-white">
  <div class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4 sm:px-6">
    <a href="/my" class="flex items-center gap-3">
      <%- include('brand-mark') %>
      <span class="font-serif text-lg font-bold"><%= brand.name %></span>
    </a>
    <nav class="flex items-center gap-4 text-sm" aria-label="Account">
      <a href="/my" class="hover:text-gold-700">My Cases</a>
      <a href="/my/profile" class="hover:text-gold-700">My Details</a>
      <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="underline">Sign out</button></form>
    </nav>
  </div>
</header>
<% if (flash) { %><div class="mx-auto mt-4 max-w-4xl rounded-md border border-gold-200 bg-gold-50 px-4 py-3 text-sm"><%= flash %></div><% } %>
<main class="mx-auto max-w-4xl px-4 py-8 sm:px-6">
