<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= typeof title !== 'undefined' ? title : 'Portal' %> — <%= brand.name %> Portal</title>
  <link rel="stylesheet" href="/assets/app.css">
</head>
<body class="bg-navy-50 font-sans text-navy-900 antialiased">
<div class="flex min-h-screen">
  <aside class="no-print hidden w-64 shrink-0 bg-navy-900 text-navy-100 lg:block">
    <div class="flex items-center gap-2 border-b border-navy-700 px-4 py-4">
      <span class="font-serif font-bold text-white"><%= brand.case_prefix %> Portal</span>
    </div>
    <nav class="space-y-1 px-2 py-4 text-sm" aria-label="Portal navigation">
      <% const nav = [
        ['/portal', 'Dashboard', 'leads.view'],
        ['/portal/leads', 'Leads', 'leads.view'],
        ['/portal/cases', 'Cases', 'cases.view'],
        ['/portal/pipeline', 'Pipeline', 'cases.view'],
        ['/portal/tasks', 'Task Center', 'tasks.view'],
        ['/portal/calendar', 'Calendar', 'tasks.view'],
        ['/portal/documents', 'Document Center', 'documents.view'],
        ['/portal/communications', 'Communication Center', 'communications.view'],
        ['/portal/automations', 'Automation Center', 'automations.view'],
        ['/portal/reports', 'Reporting Center', 'reports.view'],
        ['/portal/print', 'Print & Export Center', 'reports.export'],
        ['/portal/payments', 'Payments', 'payments.view'],
        ['/portal/admin', 'Administration', 'admin.settings'],
        ['/portal/audit', 'Audit Log', 'audit.view'],
      ]; %>
      <% for (const [href, label, perm] of nav) { if (can(perm)) { %>
        <a href="<%= href %>" class="block rounded-md px-3 py-2 transition hover:bg-navy-800 hover:text-white"><%= label %></a>
      <% } } %>
    </nav>
  </aside>
  <div class="flex min-w-0 flex-1 flex-col">
    <header class="no-print flex flex-wrap items-center gap-4 border-b border-navy-100 bg-white px-4 py-3">
      <form action="/portal/search" method="get" class="max-w-lg flex-1" role="search">
        <label for="global-search" class="sr-only">Global search</label>
        <input id="global-search" type="search" name="q" value="<%= query.q ?? '' %>" placeholder="Search cases, names, addresses, parcels, phones…" class="form-input !py-2">
      </form>
      <% if (can('leads.create')) { %><a href="/portal/leads/create" class="btn-gold !px-3 !py-2 text-sm">+ Lead</a><% } %>
      <% if (can('cases.create')) { %><a href="/portal/cases/create" class="btn-gold !px-3 !py-2 text-sm">+ Case</a><% } %>
      <% if (can('tasks.manage')) { %><a href="/portal/tasks/create" class="btn-gold !px-3 !py-2 text-sm">+ Task</a><% } %>
      <div class="flex items-center gap-3 text-sm">
        <span class="hidden text-navy-500 sm:inline"><%= user.name %></span>
        <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="text-navy-500 underline hover:text-navy-800">Sign out</button></form>
      </div>
    </header>
    <% if (flash) { %><div class="mx-6 mt-4 rounded-md border border-gold-200 bg-gold-50 px-4 py-3 text-sm"><%= flash %></div><% } %>
    <main class="flex-1 px-4 py-6 sm:px-6">
