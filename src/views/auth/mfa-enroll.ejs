<%- include('../partials/site-top', { title: 'Set Up Two-Factor Authentication' }) %>
<div class="mx-auto max-w-md px-4 py-16">
  <div class="card">
    <h1 class="font-serif text-2xl font-bold">Set Up Two-Factor Authentication</h1>
    <p class="mt-2 text-sm text-navy-500">Two-factor authentication is required for all staff accounts. Add this account to your authenticator app, then confirm with a 6-digit code.</p>
    <div class="mt-6 rounded-md bg-navy-50 p-4 text-sm">
      <p class="font-semibold">Setup key (enter manually in your authenticator app):</p>
      <p class="mt-2 select-all break-all font-mono text-base"><%= secret %></p>
      <p class="mt-3 text-xs text-navy-500">Or use this link on a device with an authenticator app:</p>
      <p class="mt-1 select-all break-all font-mono text-xs"><%= otpauthUrl %></p>
    </div>
    <form method="post" action="/mfa/enroll" class="mt-6 space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div><label class="form-label" for="code">6-digit code from your app</label>
        <input class="form-input" type="text" inputmode="numeric" pattern="[0-9]{6}" id="code" name="code" required autocomplete="one-time-code" autofocus></div>
      <button type="submit" class="btn-primary w-full">Confirm &amp; Enable</button>
    </form>
  </div>
</div>
<%- include('../partials/site-bottom') %>
