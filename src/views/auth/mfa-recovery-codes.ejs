<%- include('../partials/site-top', { title: 'Recovery Codes' }) %>
<div class="mx-auto max-w-md px-4 py-16">
  <div class="card">
    <h1 class="font-serif text-2xl font-bold">Save Your Recovery Codes</h1>
    <p class="mt-2 text-sm text-navy-500">Store these codes somewhere safe. Each code can be used once if you lose access to your authenticator app. They will not be shown again.</p>
    <ul class="mt-6 grid grid-cols-2 gap-2 font-mono text-sm">
      <% for (const code of recoveryCodes) { %><li class="rounded bg-navy-50 px-3 py-2"><%= code %></li><% } %>
    </ul>
    <a href="/portal" class="btn-primary mt-6 w-full">Continue</a>
  </div>
</div>
<%- include('../partials/site-bottom') %>
