<%- include('../../partials/portal-top', { title: automation ? automation.name : 'New Automation' }) %>
<h1 class="font-serif text-2xl font-bold"><%= automation ? 'Edit Automation' : 'New Automation' %></h1>
<div class="mt-6 grid gap-6 xl:grid-cols-2">
  <form method="post" action="<%= automation ? '/portal/automations/' + automation.id : '/portal/automations' %>" class="card space-y-4">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <% if (automation) { %><input type="hidden" name="_method" value="PUT"><% } %>
    <div><label class="form-label">Name *</label><input class="form-input" name="name" required value="<%= automation?.name ?? '' %>"></div>
    <div><label class="form-label">Description</label><textarea class="form-input" name="description" rows="2"><%= automation?.description ?? '' %></textarea></div>
    <div><label class="form-label">Trigger *</label>
      <select class="form-input" name="trigger_event">
        <% for (const trigger of triggers) { %><option value="<%= trigger %>" <%= automation?.trigger_event === trigger ? 'selected' : '' %>><%= trigger %></option><% } %>
      </select></div>
    <div><label class="form-label">Conditions (JSON array of {field, operator, value})</label>
      <textarea class="form-input font-mono text-sm" name="conditions_json" rows="4"><%= automation ? JSON.stringify(JSON.parse(automation.conditions || '[]'), null, 2) : '[]' %></textarea></div>
    <div><label class="form-label">Actions (JSON array of {type, params}) *</label>
      <textarea class="form-input font-mono text-sm" name="actions_json" rows="6"><%= automation ? JSON.stringify(JSON.parse(automation.actions || '[]'), null, 2) : '[]' %></textarea></div>
    <div class="grid gap-4 sm:grid-cols-2">
      <div><label class="form-label">Max runs / hour</label><input class="form-input" type="number" name="max_runs_per_hour" value="<%= automation?.max_runs_per_hour ?? 100 %>"></div>
      <div><label class="form-label">Max runs / case / day</label><input class="form-input" type="number" name="max_runs_per_case_per_day" value="<%= automation?.max_runs_per_case_per_day ?? 5 %>"></div>
    </div>
    <button class="btn-primary">Save (returns to draft if sensitive)</button>
  </form>
  <div class="space-y-6">
    <% if (automation) { %>
    <div class="card">
      <h2 class="font-serif text-lg font-bold">Mode &amp; Safety</h2>
      <p class="mt-1 text-sm text-navy-500">Draft: never runs. Test: logs matches without acting. Approval: queues runs for manual approval. Active: runs live.</p>
      <% if (can('automations.approve')) { %>
      <form method="post" action="/portal/automations/<%= automation.id %>/mode" class="mt-3 flex items-end gap-3">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div><label class="form-label text-xs">Mode</label>
          <select class="form-input !py-1.5" name="mode">
            <% for (const mode of ['draft', 'test', 'approval', 'active']) { %><option value="<%= mode %>" <%= automation.mode === mode ? 'selected' : '' %>><%= mode %></option><% } %>
          </select></div>
        <label class="flex items-center gap-2 pb-2 text-sm"><input type="hidden" name="paused" value="0"><input type="checkbox" name="paused" value="1" <%= automation.paused ? 'checked' : '' %>> Paused</label>
        <button class="btn-outline !py-2">Apply</button>
      </form>
      <% } %>
      <% if (automation.is_sensitive) { %>
        <p class="mt-3 rounded bg-gold-50 px-3 py-2 text-sm">This automation sends outbound communications and requires administrator approval to activate. Edits reset approval.</p>
      <% } %>
    </div>
    <div class="card">
      <h2 class="font-serif text-lg font-bold">Recent Runs</h2>
      <ul class="mt-3 max-h-72 space-y-1 overflow-y-auto text-xs">
        <% if (!runs.length) { %><li class="text-navy-400">No runs yet.</li><% } %>
        <% for (const run of runs) { %>
          <li><span class="badge <%= run.status === 'failed' ? 'bg-burgundy-500/15 text-burgundy-700' : 'bg-navy-100' %>"><%= run.status %></span>
            <%= new Date(run.created_at).toLocaleString() %> — <%= (run.message ?? '').slice(0, 90) %></li>
        <% } %>
      </ul>
    </div>
    <div class="card">
      <h2 class="font-serif text-lg font-bold">Version History</h2>
      <ul class="mt-3 space-y-1 text-xs">
        <% for (const version of versions) { %><li>v<%= version.version %> — <%= new Date(version.created_at).toLocaleString() %></li><% } %>
      </ul>
    </div>
    <% } %>
  </div>
</div>
<%- include('../../partials/portal-bottom') %>
