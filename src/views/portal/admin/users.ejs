<%- include('../../partials/portal-top', { title: 'Users' }) %>
<h1 class="font-serif text-2xl font-bold">Users &amp; Roles</h1>
<div class="mt-6 grid gap-6 lg:grid-cols-3">
  <div class="card lg:col-span-2 overflow-x-auto !p-0">
    <table class="min-w-full divide-y divide-navy-100">
      <thead><tr><th class="table-th">Name</th><th class="table-th">Email</th><th class="table-th">Type</th><th class="table-th">Role</th><th class="table-th">MFA</th><th class="table-th">Last login</th></tr></thead>
      <tbody class="divide-y divide-navy-50">
        <% for (const account of users) { %>
          <tr>
            <td class="table-td font-medium"><%= account.name %><%= account.deactivated_at ? ' (deactivated)' : '' %></td>
            <td class="table-td"><%= account.email %></td>
            <td class="table-td"><%= account.user_type %></td>
            <td class="table-td"><%= account.role ?? '' %></td>
            <td class="table-td"><%= account.mfa_enabled_at ? '✓' : '—' %></td>
            <td class="table-td text-xs"><%= account.last_login_at ? new Date(account.last_login_at).toLocaleString() : '—' %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <div class="card">
    <h2 class="font-serif text-lg font-bold">Invite User</h2>
    <form method="post" action="/portal/admin/users" class="mt-3 space-y-3">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div><label class="form-label">Name</label><input class="form-input" name="name" required></div>
      <div><label class="form-label">Email</label><input class="form-input" type="email" name="email" required></div>
      <div><label class="form-label">Title</label><input class="form-input" name="title"></div>
      <div><label class="form-label">Role</label>
        <select class="form-input" name="role">
          <% for (const role of roles) { %><option value="<%= role %>"><%= role %></option><% } %>
        </select></div>
      <button class="btn-primary w-full">Create User</button>
    </form>
  </div>
</div>
<%- include('../../partials/portal-bottom') %>
