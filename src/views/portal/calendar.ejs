<%- include('../partials/portal-top', { title: 'Calendar' }) %>
<% const monthLabel = start.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
   const prev = new Date(start.getFullYear(), start.getMonth() - 1, 1).toISOString().slice(0, 7);
   const next = new Date(start.getFullYear(), start.getMonth() + 1, 1).toISOString().slice(0, 7);
   const byDay = {};
   for (const t of tasks) { const k = new Date(t.due_at).getDate(); (byDay[k] ??= { tasks: [], deadlines: [] }).tasks.push(t); }
   for (const d of deadlines) { const k = new Date(d.due_at).getDate(); (byDay[k] ??= { tasks: [], deadlines: [] }).deadlines.push(d); }
   const daysInMonth = new Date(start.getFullYear(), start.getMonth() + 1, 0).getDate(); %>
<div class="flex items-center justify-between">
  <h1 class="font-serif text-2xl font-bold">Calendar — <%= monthLabel %></h1>
  <div class="flex gap-2">
    <a class="btn-outline !px-3 !py-1.5" href="/portal/calendar?month=<%= prev %>">←</a>
    <a class="btn-outline !px-3 !py-1.5" href="/portal/calendar?month=<%= next %>">→</a>
  </div>
</div>
<div class="mt-6 space-y-2">
  <% for (let day = 1; day <= daysInMonth; day++) { const entry = byDay[day]; if (!entry) continue; %>
    <div class="card !py-3">
      <p class="text-sm font-bold text-navy-600"><%= monthLabel.split(' ')[0] %> <%= day %></p>
      <% for (const deadline of entry.deadlines) { %>
        <p class="mt-1 text-sm text-burgundy-700">◆ <%= deadline.name %>
          <% if (deadline.case_number) { %><a class="font-mono text-xs underline" href="/portal/cases/<%= deadline.case_id %>"><%= deadline.case_number %></a><% } %></p>
      <% } %>
      <% for (const task of entry.tasks) { %>
        <p class="mt-1 text-sm">• <%= task.title %>
          <% if (task.case_number) { %><a class="font-mono text-xs underline" href="/portal/cases/<%= task.case_id %>"><%= task.case_number %></a><% } %></p>
      <% } %>
    </div>
  <% } %>
  <% if (!Object.keys(byDay).length) { %><p class="text-navy-400">Nothing scheduled this month.</p><% } %>
</div>
<%- include('../partials/portal-bottom') %>
