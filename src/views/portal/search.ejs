<%- include('../partials/portal-top', { title: 'Search' }) %>
<h1 class="font-serif text-2xl font-bold">Search results for "<%= q %>"</h1>
<ul class="mt-6 space-y-2">
  <% if (!results.length) { %><li class="text-navy-500">No matches found.</li><% } %>
  <% for (const result of results) { %>
    <li class="card !py-3">
      <span class="badge bg-navy-100 text-navy-700"><%= result.type %></span>
      <a href="<%= result.url %>" class="ml-2 font-semibold underline"><%= result.label %></a>
    </li>
  <% } %>
</ul>
<%- include('../partials/portal-bottom') %>
