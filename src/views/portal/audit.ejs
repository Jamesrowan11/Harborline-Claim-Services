<%- include('../partials/portal-top', { title: 'Audit Log' }) %>
<h1 class="font-serif text-2xl font-bold">Audit Log</h1>
<form class="no-print mt-4 flex flex-wrap gap-3" method="get">
  <input class="form-input max-w-48 !py-2" name="event" value="<%= query.event ?? '' %>" placeholder="Event (e.g. login)">
  <input class="form-input !py-2" type="date" name="from" value="<%= query.from ?? '' %>">
  <input class="form-input !py-2" type="date" name="to" value="<%= query.to ?? '' %>">
  <button class="btn-outline !py-2">Filter</button>
</form>
<div class="card mt-4 overflow-x-auto !p-0">
  <table class="min-w-full divide-y divide-navy-100">
    <thead><tr><th class="table-th">When</th><th class="table-th">User</th><th class="table-th">Event</th><th class="table-th">Record</th><th class="table-th">IP</th><th class="table-th">Changes</th></tr></thead>
    <tbody class="divide-y divide-navy-50">
      <% for (const event of events) { %>
        <tr>
          <td class="table-td text-xs"><%= new Date(event.created_at).toLocaleString() %></td>
          <td class="table-td"><%= event.user_name ?? 'System' %></td>
          <td class="table-td"><span class="badge bg-navy-100"><%= event.event %></span></td>
          <td class="table-td text-xs"><%= event.auditable_type ? `${event.auditable_type} #${event.auditable_id}` : '—' %></td>
          <td class="table-td text-xs"><%= event.ip_address ?? '' %></td>
          <td class="table-td text-xs">
            <% if (event.new_values) { %>
              <details><summary class="cursor-pointer underline">view</summary>
                <pre class="mt-1 max-w-md overflow-x-auto rounded bg-navy-50 p-2 text-xs"><%= JSON.stringify(JSON.parse(event.new_values), null, 2) %></pre></details>
            <% } %>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/portal-bottom') %>
