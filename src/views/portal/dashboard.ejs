<%- include('../partials/portal-top', { title: 'Dashboard' }) %>
<h1 class="font-serif text-2xl font-bold">Dashboard</h1>
<% const money = (v) => '$' + Number(v ?? 0).toLocaleString('en-US', { minimumFractionDigits: 2 }); %>
<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <% const tiles = [
    ['New Leads', widgets.new_leads], ['Active Cases', widgets.active_cases],
    ['Estimated Surplus', money(widgets.estimated_surplus)], ['Verified Surplus', money(widgets.verified_surplus)],
    ['Claims Filed', widgets.claims_filed], ['Funds Received', money(widgets.funds_received)],
    ['Client Distributions', money(widgets.client_distributions)], ['Company Revenue', money(widgets.company_revenue)],
    ['Overdue Tasks', widgets.overdue_tasks], ['Deadlines (14 days)', widgets.upcoming_deadlines],
    ['Stale Verifications', widgets.stale_verifications], ['Missing Documents', widgets.missing_documents],
  ]; %>
  <% for (const [label, value] of tiles) { %>
    <div class="card"><p class="text-xs font-semibold uppercase tracking-wide text-navy-400"><%= label %></p>
      <p class="mt-1 font-serif text-2xl font-bold text-navy-900"><%= value %></p></div>
  <% } %>
</div>
<% if (widgets.automation_failures > 0) { %>
  <p class="mt-4 rounded-md border border-burgundy-500 bg-burgundy-500/10 px-4 py-3 text-sm">
    <%= widgets.automation_failures %> automation failures in the last 7 days. <a href="/portal/automations" class="underline">Review</a>
  </p>
<% } %>
<div class="mt-8 grid gap-6 lg:grid-cols-3">
  <div class="card">
    <h2 class="font-serif text-lg font-bold">Cases by Stage</h2>
    <ul class="mt-3 max-h-96 space-y-1 overflow-y-auto text-sm">
      <% for (const row of casesByStage.filter((r) => Number(r.total) > 0)) { %>
        <li class="flex justify-between"><span><%= row.name %></span><span class="font-semibold"><%= row.total %></span></li>
      <% } %>
    </ul>
  </div>
  <div class="card">
    <h2 class="font-serif text-lg font-bold">Cases by County</h2>
    <ul class="mt-3 space-y-1 text-sm">
      <% for (const row of casesByCounty) { %>
        <li class="flex justify-between"><span><%= row.county %></span><span class="font-semibold"><%= row.total %></span></li>
      <% } %>
    </ul>
  </div>
  <div class="card">
    <h2 class="font-serif text-lg font-bold">My Open Tasks</h2>
    <ul class="mt-3 space-y-2 text-sm">
      <% if (!myTasks.length) { %><li class="text-navy-400">Nothing assigned. Well done.</li><% } %>
      <% for (const task of myTasks) { %>
        <li><%= task.title %>
          <% if (task.case_number) { %><span class="font-mono text-xs text-navy-400"><%= task.case_number %></span><% } %>
          <% if (task.due_at) { %><span class="text-navy-400">— <%= new Date(task.due_at).toLocaleDateString() %></span><% } %>
        </li>
      <% } %>
    </ul>
  </div>
</div>
<%- include('../partials/portal-bottom') %>
