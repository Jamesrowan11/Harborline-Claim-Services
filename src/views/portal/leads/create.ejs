<%- include('../../partials/portal-top', { title: 'New Lead' }) %>
<h1 class="font-serif text-2xl font-bold">New Lead (staff entry)</h1>
<form method="post" action="/portal/leads" class="card mt-6 max-w-2xl space-y-4">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="grid gap-4 sm:grid-cols-3">
    <div><label class="form-label">First name *</label><input class="form-input" name="first_name" required></div>
    <div><label class="form-label">Middle</label><input class="form-input" name="middle_name"></div>
    <div><label class="form-label">Last name *</label><input class="form-input" name="last_name" required></div>
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    <div><label class="form-label">Former owner</label><input class="form-input" name="former_owner_name"></div>
    <div><label class="form-label">Relationship</label><input class="form-input" name="relationship_to_owner"></div>
  </div>
  <div><label class="form-label">Property address</label><input class="form-input" name="property_address"></div>
  <div class="grid gap-4 sm:grid-cols-2">
    <div><label class="form-label">County</label><input class="form-input" name="property_county"></div>
    <div><label class="form-label">State</label><input class="form-input" name="property_state" maxlength="2" value="MD"></div>
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    <div><label class="form-label">Email</label><input class="form-input" type="email" name="email"></div>
    <div><label class="form-label">Phone</label><input class="form-input" name="phone"></div>
  </div>
  <div><label class="form-label">Notes</label><textarea class="form-input" name="description" rows="3"></textarea></div>
  <label class="flex items-center gap-2"><input type="checkbox" name="consent_to_contact" value="1"> Caller gave verbal consent to contact</label>
  <button class="btn-primary">Create Lead</button>
</form>
<%- include('../../partials/portal-bottom') %>
