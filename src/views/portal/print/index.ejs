<%- include('../../partials/portal-top', { title: 'Print & Export Center' }) %>
<h1 class="font-serif text-2xl font-bold">Print &amp; Export Center</h1>
<p class="mt-2 max-w-2xl text-sm text-navy-500">Every report supports print preview, print-friendly mode, CSV, formatted XLSX (bold frozen headers, filters, totals, confidentiality footer), and PDF in Letter or Legal, portrait or landscape.</p>
<% const groups = {}; for (const [key, report] of Object.entries(reports)) (groups[report.group] ??= []).push([key, report]); %>
<% for (const [group, items] of Object.entries(groups)) { %>
  <h2 class="mt-8 font-serif text-lg font-bold text-navy-700"><%= group %></h2>
  <div class="mt-3 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    <% for (const [key, report] of items) { %>
      <div class="card">
        <h3 class="font-semibold"><%= report.name %></h3>
        <form method="get" action="/portal/print/<%= key %>" class="mt-3 space-y-2 text-sm">
          <div class="flex gap-2">
            <input class="form-input !py-1" type="date" name="from" aria-label="From">
            <input class="form-input !py-1" type="date" name="to" aria-label="To">
          </div>
          <div class="flex flex-wrap gap-2">
            <button class="btn-outline !px-3 !py-1">Preview / Print</button>
            <button class="btn-outline !px-3 !py-1" formaction="/portal/print/<%= key %>/export" name="format" value="xlsx">XLSX</button>
            <button class="btn-outline !px-3 !py-1" formaction="/portal/print/<%= key %>/export" name="format" value="csv">CSV</button>
            <button class="btn-outline !px-3 !py-1" formaction="/portal/print/<%= key %>/export" name="format" value="pdf">PDF</button>
          </div>
        </form>
      </div>
    <% } %>
  </div>
<% } %>
<%- include('../../partials/portal-bottom') %>
