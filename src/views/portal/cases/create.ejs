<%- include('../../partials/portal-top', { title: 'New Case' }) %>
<h1 class="font-serif text-2xl font-bold">New Case</h1>
<form method="post" action="/portal/cases" class="card mt-6 max-w-2xl space-y-4">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="grid gap-4 sm:grid-cols-2">
    <div><label class="form-label">County *</label><input class="form-input" name="county" required></div>
    <div><label class="form-label">State *</label><input class="form-input" name="state" maxlength="2" required value="MD"></div>
  </div>
  <div><label class="form-label">Property address</label><input class="form-input" name="address_line1"></div>
  <div class="grid gap-4 sm:grid-cols-3">
    <div><label class="form-label">City</label><input class="form-input" name="city"></div>
    <div><label class="form-label">ZIP</label><input class="form-input" name="zip"></div>
    <div><label class="form-label">Parcel #</label><input class="form-input" name="parcel_number"></div>
  </div>
  <div><label class="form-label">Estimated surplus (if known)</label><input class="form-input" type="number" step="0.01" min="0" name="estimated_surplus"></div>
  <button class="btn-primary">Create Case</button>
</form>
<%- include('../../partials/portal-bottom') %>
