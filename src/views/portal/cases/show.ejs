<%- include('../../partials/portal-top', { title: caseRow.case_number }) %>
<% const money = (v) => v ? '$' + Number(v).toLocaleString('en-US', { minimumFractionDigits: 2 }) : '—'; %>
<div class="flex flex-wrap items-center justify-between gap-3">
  <div>
    <h1 class="font-serif text-2xl font-bold"><%= caseRow.case_number %></h1>
    <p class="text-sm text-navy-500">
      <span class="badge bg-navy-100 text-navy-700"><%= stage.name %></span>
      <span class="ml-2">Client sees: <em><%= stage.client_label %></em></span>
      <% if (caseRow.compliance_hold || caseRow.legal_hold || stage.is_hold) { %><span class="badge ml-2 bg-burgundy-500/15 text-burgundy-700">ON HOLD</span><% } %>
      <% if (stage.requires_attorney_review) { %><span class="badge ml-2 bg-gold-100 text-gold-800">Attorney review required</span><% } %>
    </p>
  </div>
  <% if (can('cases.change_stage')) { %>
  <form method="post" action="/portal/cases/<%= caseRow.id %>/stage" class="flex items-end gap-2">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div>
      <label class="form-label !mb-0 text-xs">Move to stage</label>
      <select name="stage_id" class="form-input !py-1.5">
        <% for (const s of stages) { %><option value="<%= s.id %>" <%= caseRow.pipeline_stage_id === s.id ? 'selected' : '' %>><%= s.name %></option><% } %>
      </select>
    </div>
    <button class="btn-primary !py-2">Move</button>
  </form>
  <% } %>
</div>

<div class="mt-6 grid gap-6 xl:grid-cols-3">
  <div class="space-y-6 xl:col-span-2">
    <div class="card">
      <h2 class="font-serif text-lg font-bold">Overview</h2>
      <dl class="mt-4 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-3">
        <div><dt class="font-semibold text-navy-500">County</dt><dd><%= caseRow.county %>, <%= caseRow.state %></dd></div>
        <div><dt class="font-semibold text-navy-500">Property</dt><dd><%= property?.address_line1 ?? '—' %></dd></div>
        <div><dt class="font-semibold text-navy-500">Parcel #</dt><dd><%= property?.parcel_number ?? '—' %></dd></div>
        <div><dt class="font-semibold text-navy-500">Estimated surplus</dt><dd><%= money(caseRow.estimated_surplus) %></dd></div>
        <div><dt class="font-semibold text-navy-500">Verified surplus</dt><dd><%= money(caseRow.verified_surplus) %></dd></div>
        <div><dt class="font-semibold text-navy-500">Verification level</dt><dd><%= caseRow.verification_level %></dd></div>
        <div><dt class="font-semibold text-navy-500">Funds holder</dt><dd><%= fundsHolder?.name ?? '—' %></dd></div>
        <div><dt class="font-semibold text-navy-500">Legal complexity</dt><dd><%= caseRow.legal_complexity %></dd></div>
        <div><dt class="font-semibold text-navy-500">Outreach approved</dt><dd><%= caseRow.outreach_approved ? 'Yes' : 'No' %></dd></div>
      </dl>
      <% if (can('cases.update')) { %>
      <details class="mt-4">
        <summary class="cursor-pointer text-sm font-semibold text-navy-600">Edit case fields</summary>
        <form method="post" action="/portal/cases/<%= caseRow.id %>" class="mt-3 grid gap-3 sm:grid-cols-2">
          <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="_method" value="PUT">
          <div><label class="form-label text-xs">Assigned to</label>
            <select class="form-input !py-1.5" name="assigned_to"><option value="">—</option>
              <% for (const member of staff) { %><option value="<%= member.id %>" <%= caseRow.assigned_to === member.id ? 'selected' : '' %>><%= member.name %></option><% } %>
            </select></div>
          <div><label class="form-label text-xs">Case manager</label>
            <select class="form-input !py-1.5" name="case_manager_id"><option value="">—</option>
              <% for (const member of staff) { %><option value="<%= member.id %>" <%= caseRow.case_manager_id === member.id ? 'selected' : '' %>><%= member.name %></option><% } %>
            </select></div>
          <div><label class="form-label text-xs">Estimated surplus</label><input class="form-input !py-1.5" type="number" step="0.01" name="estimated_surplus" value="<%= caseRow.estimated_surplus ?? '' %>"></div>
          <div><label class="form-label text-xs">Verified surplus</label><input class="form-input !py-1.5" type="number" step="0.01" name="verified_surplus" value="<%= caseRow.verified_surplus ?? '' %>"></div>
          <div><label class="form-label text-xs">Verification level</label>
            <select class="form-input !py-1.5" name="verification_level">
              <% for (const level of ['none', 'preliminary', 'source_confirmed', 'holder_confirmed']) { %>
                <option value="<%= level %>" <%= caseRow.verification_level === level ? 'selected' : '' %>><%= level %></option><% } %>
            </select></div>
          <div><label class="form-label text-xs">Legal complexity</label>
            <select class="form-input !py-1.5" name="legal_complexity">
              <% for (const lc of ['standard', 'probate', 'heirship', 'trust', 'business', 'bankruptcy', 'disputed']) { %>
                <option value="<%= lc %>" <%= caseRow.legal_complexity === lc ? 'selected' : '' %>><%= lc %></option><% } %>
            </select></div>
          <label class="flex items-center gap-2 text-sm"><input type="hidden" name="compliance_hold" value="0"><input type="checkbox" name="compliance_hold" value="1" <%= caseRow.compliance_hold ? 'checked' : '' %>> Compliance hold</label>
          <label class="flex items-center gap-2 text-sm"><input type="hidden" name="automation_paused" value="0"><input type="checkbox" name="automation_paused" value="1" <%= caseRow.automation_paused ? 'checked' : '' %>> Pause automations</label>
          <% if (can('compliance.review')) { %>
            <label class="flex items-center gap-2 text-sm"><input type="hidden" name="outreach_approved" value="0"><input type="checkbox" name="outreach_approved" value="1" <%= caseRow.outreach_approved ? 'checked' : '' %>> Outreach approved (compliance)</label>
          <% } %>
          <div class="sm:col-span-2"><button class="btn-primary !py-2">Save Changes</button></div>
        </form>
      </details>
      <% } %>
    </div>

    <div class="card">
      <h2 class="font-serif text-lg font-bold">Claimants</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <% for (const claimant of claimants) { %>
          <li class="flex flex-wrap items-center gap-2">
            <span class="font-semibold"><%= claimant.organization_name || [claimant.first_name, claimant.last_name].join(' ') %></span>
            <span class="badge bg-navy-100 text-navy-700"><%= claimant.pivot_role %></span>
            <span class="text-navy-500"><%= claimant.email ?? '' %> <%= claimant.phone ?? '' %></span>
            <span class="badge <%= claimant.identity_verification_status === 'verified' ? 'bg-gold-100 text-gold-800' : 'bg-navy-100 text-navy-500' %>">ID: <%= claimant.identity_verification_status %></span>
          </li>
        <% } %>
      </ul>
    </div>

    <div class="card">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="font-serif text-lg font-bold">Documents</h2>
        <% if (can('documents.upload')) { %>
        <form method="post" action="/portal/documents" enctype="multipart/form-data" class="flex flex-wrap items-center gap-2 text-sm">
          <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="case_id" value="<%= caseRow.id %>">
          <input type="file" name="file" required class="text-xs">
          <input type="text" name="title" placeholder="Title" required class="form-input !w-36 !py-1">
          <select name="category" class="form-input !w-32 !py-1">
            <% for (const cat of ['identity', 'agreement', 'court', 'property', 'correspondence', 'general']) { %><option value="<%= cat %>"><%= cat %></option><% } %>
          </select>
          <label class="flex items-center gap-1 text-xs"><input type="checkbox" name="client_visible" value="1"> client-visible</label>
          <button class="btn-outline !px-3 !py-1">Upload</button>
        </form>
        <% } %>
      </div>
      <table class="mt-3 min-w-full text-sm">
        <thead><tr><th class="table-th">Title</th><th class="table-th">Category</th><th class="table-th">Status</th><th class="table-th">Client?</th><th class="table-th"></th></tr></thead>
        <tbody class="divide-y divide-navy-50">
          <% for (const document of documents) { %>
            <tr>
              <td class="table-td"><%= document.title %></td>
              <td class="table-td"><%= document.category %></td>
              <td class="table-td"><span class="badge bg-navy-100"><%= document.status %></span> <span class="text-xs text-navy-400"><%= document.virus_scan_status %></span></td>
              <td class="table-td"><%= document.client_visible ? 'visible' : 'staff-only' %></td>
              <td class="table-td space-x-2">
                <% if (can('documents.download')) { %><a class="underline" href="/portal/documents/<%= document.id %>/download">Download</a><% } %>
                <% if (document.status === 'pending' && can('documents.approve')) { %>
                  <form class="inline" method="post" action="/portal/documents/<%= document.id %>/review"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="status" value="approved"><button class="underline">Approve</button></form>
                  <form class="inline" method="post" action="/portal/documents/<%= document.id %>/review"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="status" value="rejected"><button class="text-burgundy-600 underline">Reject</button></form>
                <% } %>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
      <% if (documentRequests.length) { %>
        <h3 class="mt-4 text-sm font-bold text-navy-600">Document requests</h3>
        <ul class="mt-1 text-sm">
          <% for (const request of documentRequests) { %><li><%= request.name %> — <span class="badge bg-navy-100"><%= request.status %></span></li><% } %>
        </ul>
      <% } %>
    </div>

    <div class="card">
      <h2 class="font-serif text-lg font-bold">Recent Communications</h2>
      <% if (can('communications.send')) { %><a class="text-sm underline" href="/portal/communications/compose?case_id=<%= caseRow.id %>">Compose from template</a><% } %>
      <ul class="mt-3 space-y-2 text-sm">
        <% if (!communications.length) { %><li class="text-navy-400">No communications yet.</li><% } %>
        <% for (const communication of communications) { %>
          <li class="rounded bg-navy-50 p-2">
            <span class="badge bg-white"><%= communication.channel %></span>
            <span class="badge bg-white"><%= communication.direction %></span>
            <span class="badge bg-white"><%= communication.status %></span>
            <span class="font-semibold"><%= communication.subject ?? '' %></span>
            <span class="text-xs text-navy-400"><%= new Date(communication.created_at).toLocaleString() %></span>
          </li>
        <% } %>
      </ul>
    </div>

    <div class="card">
      <h2 class="font-serif text-lg font-bold">Financials</h2>
      <div class="mt-3 grid gap-6 md:grid-cols-2">
        <div>
          <h3 class="text-sm font-bold text-navy-600">Claims</h3>
          <ul class="mt-1 space-y-1 text-sm">
            <% if (!claims.length) { %><li class="text-navy-400">No claims yet.</li><% } %>
            <% for (const claim of claims) { %>
              <li><%= claim.status %> — <%= money(claim.amount_claimed) %> <% if (claim.filed_at) { %>(filed <%= new Date(claim.filed_at).toLocaleDateString() %>)<% } %></li>
            <% } %>
          </ul>
        </div>
        <div>
          <h3 class="text-sm font-bold text-navy-600">Payments</h3>
          <ul class="mt-1 space-y-1 text-sm">
            <% if (!payments.length) { %><li class="text-navy-400">No payments recorded.</li><% } %>
            <% for (const payment of payments) { %>
              <li><%= payment.payment_type.replaceAll('_', ' ') %>: <%= money(payment.amount) %> (<%= new Date(payment.occurred_on).toLocaleDateString() %>)</li>
            <% } %>
          </ul>
          <% if (can('payments.manage')) { %>
          <form method="post" action="/portal/payments" class="mt-3 grid grid-cols-2 gap-2 text-sm">
            <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="case_id" value="<%= caseRow.id %>">
            <select name="payment_type" class="form-input !py-1">
              <% for (const type of ['funds_received', 'client_distribution', 'company_fee', 'refund']) { %><option value="<%= type %>"><%= type.replaceAll('_', ' ') %></option><% } %>
            </select>
            <input class="form-input !py-1" type="number" step="0.01" min="0.01" name="amount" placeholder="0.00" required>
            <input class="form-input !py-1" type="date" name="occurred_on" value="<%= new Date().toISOString().slice(0, 10) %>" required>
            <button class="btn-outline !py-1">Record</button>
          </form>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <div class="space-y-6">
    <div class="card">
      <h2 class="font-serif text-lg font-bold">Tasks &amp; Deadlines</h2>
      <ul class="mt-3 space-y-1 text-sm">
        <% for (const task of tasks.filter((t) => t.status !== 'done')) { %>
          <li class="flex items-center justify-between gap-2 <%= task.due_at && new Date(task.due_at) < new Date() ? 'text-burgundy-600' : '' %>">
            <span><%= task.title %> <% if (task.due_at) { %><span class="text-xs text-navy-400">(<%= new Date(task.due_at).toLocaleDateString() %>)</span><% } %></span>
            <% if (can('tasks.manage')) { %><form method="post" action="/portal/tasks/<%= task.id %>/complete"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="text-xs underline">Done</button></form><% } %>
          </li>
        <% } %>
      </ul>
      <% if (can('tasks.manage')) { %><a href="/portal/tasks/create?case_id=<%= caseRow.id %>" class="mt-2 inline-block text-sm underline">Add task</a><% } %>
      <h3 class="mt-4 text-sm font-bold text-navy-600">Deadlines</h3>
      <ul class="mt-1 space-y-1 text-sm">
        <% for (const deadline of deadlines) { %>
          <li class="<%= deadline.is_critical ? 'font-semibold text-burgundy-600' : '' %>"><%= deadline.name %> — <%= new Date(deadline.due_at).toLocaleDateString() %></li>
        <% } %>
      </ul>
    </div>

    <div class="card">
      <h2 class="font-serif text-lg font-bold">Source Records</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <% for (const source of sources) { %>
          <li><span class="font-semibold"><%= source.title %></span>
            <span class="badge <%= source.status === 'stale' ? 'bg-burgundy-500/15 text-burgundy-700' : 'bg-gold-100 text-gold-800' %>"><%= source.status %></span>
            <span class="block text-xs text-navy-400"><%= source.source_type %> — <%= source.retrieved_at ? new Date(source.retrieved_at).toLocaleDateString() : '' %></span>
          </li>
        <% } %>
      </ul>
    </div>

    <div class="card">
      <h2 class="font-serif text-lg font-bold">Client Messages</h2>
      <ul class="mt-3 max-h-64 space-y-2 overflow-y-auto text-sm">
        <% if (!messages.length) { %><li class="text-navy-400">No messages.</li><% } %>
        <% for (const message of messages) { %>
          <li class="rounded p-2 <%= message.sender_type === 'client' ? 'bg-gold-50' : 'bg-navy-50' %>">
            <span class="text-xs font-semibold"><%= message.sender_name %></span>
            <p><%= message.body %></p>
            <span class="text-xs text-navy-400"><%= new Date(message.created_at).toLocaleString() %></span>
          </li>
        <% } %>
      </ul>
    </div>

    <div class="card">
      <h2 class="font-serif text-lg font-bold">Notes (staff only)</h2>
      <% if (can('notes.manage')) { %>
      <form method="post" action="/portal/cases/<%= caseRow.id %>/notes" class="mt-2">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <textarea name="body" rows="2" class="form-input text-sm" required placeholder="Add an internal note…"></textarea>
        <button class="btn-outline mt-2 !px-3 !py-1 text-sm">Add Note</button>
      </form>
      <% } %>
      <ul class="mt-3 max-h-64 space-y-2 overflow-y-auto text-sm">
        <% for (const note of notes) { %>
          <li class="rounded bg-navy-50 p-2"><%= note.body %><span class="block text-xs text-navy-400"><%= note.author_name ?? 'System' %> — <%= new Date(note.created_at).toLocaleString() %></span></li>
        <% } %>
      </ul>
    </div>

    <div class="card">
      <h2 class="font-serif text-lg font-bold">Stage History</h2>
      <ul class="mt-3 space-y-1 text-xs text-navy-500">
        <% for (const transition of transitions) { %>
          <li><%= new Date(transition.created_at).toLocaleString() %> → <span class="font-semibold text-navy-700"><%= transition.to_stage_name %></span> <%= transition.user_name ? 'by ' + transition.user_name : '(automation)' %></li>
        <% } %>
      </ul>
    </div>
  </div>
</div>
<%- include('../../partials/portal-bottom') %>
