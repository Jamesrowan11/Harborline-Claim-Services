<%- include('../../partials/portal-top', { title: 'New Task' }) %>
<h1 class="font-serif text-2xl font-bold">New Task</h1>
<form method="post" action="/portal/tasks" class="card mt-6 max-w-xl space-y-4">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <% if (caseId) { %><input type="hidden" name="case_id" value="<%= caseId %>"><% } %>
  <div><label class="form-label">Title *</label><input class="form-input" name="title" required></div>
  <div><label class="form-label">Description</label><textarea class="form-input" name="description" rows="3"></textarea></div>
  <div class="grid gap-4 sm:grid-cols-3">
    <div><label class="form-label">Assign to</label>
      <select class="form-input" name="assigned_to"><option value="">—</option>
        <% for (const member of staff) { %><option value="<%= member.id %>"><%= member.name %></option><% } %>
      </select></div>
    <div><label class="form-label">Priority</label>
      <select class="form-input" name="priority">
        <% for (const priority of ['low', 'normal', 'high', 'urgent']) { %><option value="<%= priority %>" <%= priority === 'normal' ? 'selected' : '' %>><%= priority %></option><% } %>
      </select></div>
    <div><label class="form-label">Due</label><input class="form-input" type="date" name="due_at"></div>
  </div>
  <button class="btn-primary">Create Task</button>
</form>
<%- include('../../partials/portal-bottom') %>
