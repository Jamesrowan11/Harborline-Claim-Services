<%- include('../../partials/portal-top', { title: 'Task Center' }) %>
<div class="flex flex-wrap items-center justify-between gap-3">
  <h1 class="font-serif text-2xl font-bold">Task Center</h1>
  <% if (can('tasks.manage')) { %><a href="/portal/tasks/create" class="btn-primary !py-2">New Task</a><% } %>
</div>
<div class="no-print mt-4 flex gap-2 text-sm">
  <a href="/portal/tasks" class="btn-outline !px-3 !py-1.5">Open</a>
  <a href="/portal/tasks?filter=mine" class="btn-outline !px-3 !py-1.5">Mine</a>
  <a href="/portal/tasks?filter=overdue" class="btn-outline !px-3 !py-1.5">Overdue</a>
</div>
<div class="card mt-4 overflow-x-auto !p-0">
  <table class="min-w-full divide-y divide-navy-100">
    <thead><tr><th class="table-th">Task</th><th class="table-th">Case / Lead</th><th class="table-th">Assigned</th><th class="table-th">Priority</th><th class="table-th">Due</th><th class="table-th"></th></tr></thead>
    <tbody class="divide-y divide-navy-50">
      <% if (!tasks.length) { %><tr><td colspan="6" class="table-td py-8 text-center text-navy-400">No tasks.</td></tr><% } %>
      <% for (const task of tasks) { const overdue = task.due_at && new Date(task.due_at) < new Date(); %>
        <tr class="<%= overdue ? 'bg-burgundy-500/5' : '' %>">
          <td class="table-td font-medium"><%= task.title %></td>
          <td class="table-td font-mono text-xs">
            <% if (task.case_number) { %><a class="underline" href="/portal/cases/<%= task.case_id %>"><%= task.case_number %></a>
            <% } else if (task.lead_number) { %><a class="underline" href="/portal/leads/<%= task.lead_id %>"><%= task.lead_number %></a><% } %>
          </td>
          <td class="table-td"><%= task.assignee_name ?? '' %></td>
          <td class="table-td"><span class="badge <%= ['high', 'urgent'].includes(task.priority) ? 'bg-burgundy-500/15 text-burgundy-700' : 'bg-navy-100' %>"><%= task.priority %></span></td>
          <td class="table-td <%= overdue ? 'font-semibold text-burgundy-600' : '' %>"><%= task.due_at ? new Date(task.due_at).toLocaleDateString() : '—' %></td>
          <td class="table-td"><% if (can('tasks.manage')) { %><form method="post" action="/portal/tasks/<%= task.id %>/complete"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="underline">Done</button></form><% } %></td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../../partials/portal-bottom') %>
