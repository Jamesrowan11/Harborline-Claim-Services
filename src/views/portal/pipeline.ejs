<%- include('../partials/portal-top', { title: 'Pipeline' }) %>
<h1 class="font-serif text-2xl font-bold">Case Pipeline</h1>
<div class="mt-6 flex gap-4 overflow-x-auto pb-4">
  <% for (const stage of stages) { %>
    <div class="w-72 shrink-0 rounded-lg bg-navy-100/60 p-3">
      <h2 class="flex items-center justify-between px-1 text-sm font-bold text-navy-700">
        <%= stage.name %> <span class="badge bg-white"><%= stage.total %></span>
      </h2>
      <div class="mt-3 space-y-2">
        <% for (const caseRow of stage.cases) { %>
          <a href="/portal/cases/<%= caseRow.id %>" class="block rounded-md bg-white p-3 shadow-sm transition hover:shadow">
            <p class="font-mono text-sm font-semibold"><%= caseRow.case_number %></p>
            <p class="text-xs text-navy-500"><%= caseRow.county %>, <%= caseRow.state %></p>
            <% if (caseRow.estimated_surplus) { %><p class="text-xs text-gold-700">Est. $<%= Number(caseRow.estimated_surplus).toLocaleString() %></p><% } %>
            <% if (caseRow.assignee_name) { %><p class="mt-1 text-xs text-navy-400"><%= caseRow.assignee_name %></p><% } %>
          </a>
        <% } %>
      </div>
    </div>
  <% } %>
</div>
<%- include('../partials/portal-bottom') %>
