<%- include('../partials/client-top', { title: caseRow.case_number }) %>
<a href="/my" class="text-sm text-navy-500 underline">← My Cases</a>
<h1 class="mt-2 font-serif text-3xl font-bold"><%= caseRow.case_number %></h1>
<p class="mt-2 text-xl text-navy-700">Status: <span class="font-serif font-bold text-navy-900"><%= clientLabel %></span></p>
<% if (claimSubmitted) { %><p class="mt-1 text-sm text-gold-700">✓ A claim has been submitted to the funds holder on your behalf.</p><% } %>

<div class="mt-8 space-y-6">
  <% if (documentRequests.length) { %>
    <section class="card border-l-4 border-l-gold-500">
      <h2 class="font-serif text-xl font-bold">Documents We Need From You</h2>
      <ul class="mt-3 space-y-4">
        <% for (const request of documentRequests) { %>
          <li class="rounded-md bg-navy-50 p-4">
            <p class="font-semibold"><%= request.name %> <span class="badge ml-1 bg-white"><%= request.status %></span></p>
            <% if (request.instructions) { %><p class="mt-1 text-sm text-navy-600"><%= request.instructions %></p><% } %>
            <% if (request.status === 'requested') { %>
              <form method="post" action="/my/cases/<%= caseRow.id %>/documents" enctype="multipart/form-data" class="mt-3 flex flex-wrap items-center gap-3">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <input type="hidden" name="document_request_id" value="<%= request.id %>">
                <input type="hidden" name="title" value="<%= request.name %>">
                <input type="file" name="file" required class="text-sm">
                <button class="btn-primary !py-2">Upload Securely</button>
              </form>
            <% } %>
          </li>
        <% } %>
      </ul>
    </section>
  <% } %>

  <% if (tasks.length) { %>
    <section class="card">
      <h2 class="font-serif text-xl font-bold">Outstanding Items</h2>
      <ul class="mt-3 list-disc space-y-1 pl-6 text-navy-700">
        <% for (const task of tasks) { %><li><%= task.title %></li><% } %>
      </ul>
    </section>
  <% } %>

  <% if (agreements.length) { %>
    <section class="card">
      <h2 class="font-serif text-xl font-bold">Agreements</h2>
      <ul class="mt-3 space-y-2">
        <% for (const agreement of agreements) { %>
          <li class="flex flex-wrap items-center justify-between gap-2">
            <span><%= agreement.title %> <span class="badge bg-navy-100"><%= agreement.status === 'sent' ? 'awaiting your signature' : 'signed' %></span></span>
            <a class="btn-outline !px-4 !py-1.5 text-sm" href="/my/cases/<%= caseRow.id %>/agreements/<%= agreement.id %>"><%= agreement.status === 'sent' ? 'Review & Sign' : 'View' %></a>
          </li>
        <% } %>
      </ul>
    </section>
  <% } %>

  <% if (payments.length) { %>
    <section class="card">
      <h2 class="font-serif text-xl font-bold">Payments to You</h2>
      <ul class="mt-3 space-y-1 text-navy-700">
        <% for (const payment of payments) { %>
          <li>$<%= Number(payment.amount).toLocaleString('en-US', { minimumFractionDigits: 2 }) %> — <%= new Date(payment.occurred_on).toLocaleDateString() %> (<%= payment.method ?? 'method on file' %>)</li>
        <% } %>
      </ul>
    </section>
  <% } %>

  <% if (documents.length) { %>
    <section class="card">
      <h2 class="font-serif text-xl font-bold">Your Documents</h2>
      <ul class="mt-3 space-y-1">
        <% for (const document of documents) { %>
          <li><a class="underline" href="/my/cases/<%= caseRow.id %>/documents/<%= document.id %>/download"><%= document.title %></a></li>
        <% } %>
      </ul>
    </section>
  <% } %>

  <section class="card">
    <h2 class="font-serif text-xl font-bold">Messages</h2>
    <ul class="mt-3 max-h-80 space-y-2 overflow-y-auto">
      <% if (!messages.length) { %><li class="text-navy-400">No messages yet. Questions are always welcome.</li><% } %>
      <% for (const message of messages) { %>
        <li class="rounded-md p-3 <%= message.sender_id === user.id ? 'bg-gold-50 text-right' : 'bg-navy-50' %>">
          <p class="text-xs font-semibold text-navy-500"><%= message.sender_id === user.id ? 'You' : message.sender_name %></p>
          <p class="mt-1"><%= message.body %></p>
          <p class="mt-1 text-xs text-navy-400"><%= new Date(message.created_at).toLocaleString() %></p>
        </li>
      <% } %>
    </ul>
    <form method="post" action="/my/cases/<%= caseRow.id %>/messages" class="mt-4 flex gap-3">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label class="sr-only" for="body">Message</label>
      <textarea id="body" name="body" rows="2" required class="form-input flex-1" placeholder="Write a message to your case manager…"></textarea>
      <button class="btn-primary self-end">Send</button>
    </form>
  </section>
</div>
<%- include('../partials/client-bottom') %>
