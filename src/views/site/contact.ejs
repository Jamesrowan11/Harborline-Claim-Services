<%- include('../partials/site-top', { title: 'Contact Us' }) %>
<div class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
  <h1 class="font-serif text-4xl font-bold">Contact Us</h1>
  <div class="mt-6 space-y-2 text-lg text-navy-700">
    <% if (brand.phone) { %><p><span class="font-semibold">Phone:</span> <%= brand.phone %></p><% } %>
    <% if (brand.email) { %><p><span class="font-semibold">Email:</span> <%= brand.email %></p><% } %>
    <% if (brand.address) { %><p><span class="font-semibold">Mail:</span> <%= brand.address %></p><% } %>
  </div>
  <p class="mt-4 text-navy-600">Please do not send personal identification documents by email. Use the secure portal or ask us about safe options.</p>
  <form method="post" action="/contact" class="card mt-8 space-y-5">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true">
    <div><label class="form-label" for="name">Your name</label>
      <input class="form-input" id="name" name="name" required></div>
    <div class="grid gap-5 sm:grid-cols-2">
      <div><label class="form-label" for="email">Email</label>
        <input class="form-input" type="email" id="email" name="email" required></div>
      <div><label class="form-label" for="phone">Phone (optional)</label>
        <input class="form-input" id="phone" name="phone"></div>
    </div>
    <div><label class="form-label" for="message">How can we help?</label>
      <textarea class="form-input" id="message" name="message" rows="5" required></textarea></div>
    <button class="btn-primary">Send Message</button>
  </form>
</div>
<%- include('../partials/site-bottom') %>
