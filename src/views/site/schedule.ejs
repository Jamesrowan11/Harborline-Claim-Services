<%- include('../partials/site-top', { title: 'Schedule a Call' }) %>
<div class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
  <h1 class="font-serif text-4xl font-bold">Schedule a Call</h1>
  <p class="mt-4 text-lg leading-relaxed text-navy-700">
    Prefer to talk it through? Send us a note with the times that suit you, and a member of our team will call you back. Calls are unhurried, free, and carry no obligation.
  </p>
  <% if (brand.phone) { %><p class="mt-6 text-lg">You can also call us directly at <span class="font-bold"><%= brand.phone %></span>.</p><% } %>
  <form method="post" action="/contact" class="card mt-8 space-y-5">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true">
    <div><label class="form-label" for="name">Your name</label><input class="form-input" id="name" name="name" required></div>
    <div class="grid gap-5 sm:grid-cols-2">
      <div><label class="form-label" for="email">Email</label><input class="form-input" type="email" id="email" name="email" required></div>
      <div><label class="form-label" for="phone">Phone number for the call</label><input class="form-input" id="phone" name="phone"></div>
    </div>
    <div><label class="form-label" for="message">Good days and times to reach you</label>
      <textarea class="form-input" id="message" name="message" rows="4" required placeholder="For example: weekday mornings, or Tuesday after 3pm"></textarea></div>
    <button class="btn-primary">Request a Call Back</button>
  </form>
</div>
<%- include('../partials/site-bottom') %>
