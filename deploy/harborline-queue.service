# systemd unit for the Harborline queue worker.
# Install: cp deploy/harborline-queue.service /etc/systemd/system/
#          systemctl daemon-reload && systemctl enable --now harborline-queue
[Unit]
Description=Harborline Laravel queue worker
After=network.target

[Service]
# Adjust user/group to the Plesk subscription system user
User=example_sysuser
Group=psacln
Restart=always
RestartSec=5
ExecStart=/usr/bin/php /var/www/vhosts/example.com/httpdocs/artisan queue:work --sleep=3 --tries=3 --max-time=3600
# With Redis + Horizon, use instead:
# ExecStart=/usr/bin/php /var/www/vhosts/example.com/httpdocs/artisan horizon

[Install]
WantedBy=multi-user.target
