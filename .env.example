#--------------------------------------------------------------------------
# Application
#--------------------------------------------------------------------------
APP_NAME="Harborline Claim Services"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

#--------------------------------------------------------------------------
# Branding (all values editable without rebuilding; DB settings override)
# NOTE: "Harborline Claim Services" is a PROVISIONAL working name pending
# entity-name, trademark, domain, and licensing clearance. See
# COMPLIANCE-PLACEHOLDERS.md.
#--------------------------------------------------------------------------
BRAND_NAME="Harborline Claim Services"
BRAND_LEGAL_NAME="Harborline Claim Services LLC"
BRAND_PARENT_COMPANY="Northvale Unified Inc."
BRAND_TAGLINE="Helping You Navigate the Path to Possible Surplus Funds"
BRAND_CASE_PREFIX=HCS
BRAND_PHONE=""
BRAND_EMAIL=""
BRAND_ADDRESS=""
BRAND_PRIMARY_STATE=MD
BRAND_COLOR_NAVY="#1b2a4a"
BRAND_COLOR_GOLD="#b3924f"
BRAND_COLOR_BURGUNDY="#6e2b3a"

#--------------------------------------------------------------------------
# Database — set DB_CONNECTION to pgsql (PostgreSQL 16) or mysql (MySQL 8)
#--------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=harborline
DB_USERNAME=harborline
DB_PASSWORD=

# For MySQL 8 use:
# DB_CONNECTION=mysql
# DB_PORT=3306

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# When Redis is available in Plesk, prefer:
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#--------------------------------------------------------------------------
# Mail — configure through Plesk mail or an external SMTP provider
#--------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${BRAND_NAME}"

#--------------------------------------------------------------------------
# Optional integrations (all disabled by default; see AUTOMATIONS.md)
#--------------------------------------------------------------------------
SMS_ENABLED=false
SMS_DRIVER=log            # log | twilio-compatible endpoint
SMS_API_URL=
SMS_API_KEY=
SMS_FROM_NUMBER=

VIRUS_SCAN_ENABLED=false
VIRUS_SCAN_COMMAND="clamdscan --no-summary"

CAPTCHA_ENABLED=true
CAPTCHA_DRIVER=honeypot   # honeypot | turnstile | recaptcha
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

#--------------------------------------------------------------------------
# Security
#--------------------------------------------------------------------------
MFA_REQUIRED_FOR_STAFF=true
LOGIN_ALERTS_ENABLED=true
AUTOMATION_GLOBAL_STOP=false

VITE_APP_NAME="${APP_NAME}"
