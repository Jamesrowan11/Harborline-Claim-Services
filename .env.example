#--------------------------------------------------------------------------
# Application
#--------------------------------------------------------------------------
NODE_ENV=production
APP_URL=https://example.com
PORT=3000
# Generate with: node src/cli.js key:generate  (encrypts MFA secrets, DOB, SSN-last-4)
APP_KEY=

#--------------------------------------------------------------------------
# Branding (all values editable without rebuilding; DB settings override)
# NOTE: "Harborline Claim Services" is a PROVISIONAL working name pending
# entity-name, trademark, domain, and licensing clearance.
# See COMPLIANCE-PLACEHOLDERS.md.
#--------------------------------------------------------------------------
BRAND_NAME="Harborline Claim Services"
BRAND_LEGAL_NAME="Harborline Claim Services LLC"
BRAND_PARENT_COMPANY="Northvale Unified Inc."
BRAND_TAGLINE="Helping You Navigate the Path to Possible Surplus Funds"
BRAND_CASE_PREFIX=HCS
BRAND_PHONE=""
BRAND_EMAIL=""
BRAND_ADDRESS=""
BRAND_PRIMARY_STATE=MD

#--------------------------------------------------------------------------
# Database — pgsql (PostgreSQL 16), mysql (MySQL 8), or sqlite (dev only)
#--------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=harborline
DB_USERNAME=harborline
DB_PASSWORD=

# For MySQL 8 use:
# DB_CONNECTION=mysql
# DB_PORT=3306

#--------------------------------------------------------------------------
# Mail — Plesk local mail, your email provider's SMTP, or a transactional
# service (Amazon SES recommended). MAIL_MAILER=log writes to a file (dev).
#--------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com

#--------------------------------------------------------------------------
# Optional integrations (all disabled by default)
#--------------------------------------------------------------------------
SMS_ENABLED=false
SMS_DRIVER=log            # log | twilio-compatible
SMS_API_URL=
SMS_API_KEY=
SMS_FROM_NUMBER=

VIRUS_SCAN_ENABLED=false
VIRUS_SCAN_COMMAND="clamdscan --no-summary"

#--------------------------------------------------------------------------
# Security
#--------------------------------------------------------------------------
MFA_REQUIRED_FOR_STAFF=true
LOGIN_ALERTS_ENABLED=true
AUTOMATION_GLOBAL_STOP=false
SESSION_LIFETIME=30
MAX_UPLOAD_MB=20
