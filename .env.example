# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://harborline_app:CHANGE_ME@localhost:5432/harborline
SESSION_SECRET=generate_a_long_random_string
PII_ENCRYPTION_KEY=generate_a_32_byte_base64_key
NODE_ENV=development
PORT=3000

